<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GerenciadorFinal.ico</ApplicationIcon>
    <AssemblyName>GerenciadorFinal</AssemblyName>
    <RootNamespace>GerenciadorAplicativos</RootNamespace>
    <Version>5.12.13</Version>
    <Title>Gerenciador Final</Title>
    <Description>Gerenciador Final: atualizações, diagnóstico e manutenção do Windows.</Description>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <!-- Os projetos de testes sao compilados separadamente. -->
  <ItemGroup>
    <Compile Remove="TestesMotor/**/*.cs;TestesRede/**/*.cs;TestesAtualizador/**/*.cs;TestesCatalogo/**/*.cs;TestesMultifontes/**/*.cs;TestesMsix/**/*.cs" />
  </ItemGroup>
</Project>
