<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- DPI fisico de cada monitor; corresponde aos testes do layout. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GerenciadorFinal.ico</ApplicationIcon>
    <AssemblyName>GerenciadorFinal</AssemblyName>
    <RootNamespace>GerenciadorAplicativos</RootNamespace>
    <Version>5.13.11.66</Version>
    <DefineConstants>$(DefineConstants);GF_BETA</DefineConstants>
    <Title>Gerenciador Final</Title>
    <Description>Gerenciador Final: atualizações, diagnóstico e manutenção do Windows.</Description>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <MicrosoftManagementDeployment-Platform>x64</MicrosoftManagementDeployment-Platform>
    <MicrosoftManagementDeployment-FactoryLinkage>static</MicrosoftManagementDeployment-FactoryLinkage>
    <MicrosoftManagementDeployment-OutputWinMD>false</MicrosoftManagementDeployment-OutputWinMD>
  </PropertyGroup>
  <!-- Os projetos de testes sao compilados separadamente. -->
  <ItemGroup>
    <Compile Remove="TestesMotor/**/*.cs;TestesRede/**/*.cs;TestesAtualizador/**/*.cs;TestesCatalogo/**/*.cs;TestesMultifontes/**/*.cs;TestesMsix/**/*.cs;TestesFechamento/**/*.cs;TestesResiduos/**/*.cs;TestesLayout/**/*.cs;TestesSeguranca/**/*.cs;TestesDrivers/**/*.cs;TestesTelemetria/**/*.cs" />
    <!-- Os pilotos anteriores permanecem como fixtures de regressao no projeto
         TestesResiduos. O produto distribui um unico executor residual integrado. -->
    <Compile Remove="SmallAppResidualCleanup.cs;SevenZipCompleteCleanup.cs" />
    <Compile Remove="TestesEcossistema/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CatalogoDesinstalacao.json" LogicalName="GerenciadorFinal.UninstallCatalog" />
    <EmbeddedResource Include="CatalogoIdentidades.json" LogicalName="GerenciadorFinal.ApplicationIdentityCatalog" />
    <EmbeddedResource Include="CatalogoAuditoriaHistorica.json" LogicalName="GerenciadorFinal.HistoricalOrphanCatalog" />
  </ItemGroup>
  <!-- Publicar avisos a partir dos mesmos packs resolvidos, sem copiar SDKs. -->
  <ItemGroup>
    <None Update="LICENSE" CopyToPublishDirectory="PreserveNewest" TargetPath="LICENSE.txt" />
    <None Update="PRIVACY.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="docs/AVISO-PRIVACIDADE-BETA.md" CopyToPublishDirectory="PreserveNewest" TargetPath="AVISO-PRIVACIDADE-BETA.md" />
    <None Update="docs/USO-PORTATIL.md" CopyToPublishDirectory="PreserveNewest" TargetPath="LEIA-ME.md" />
    <None Update="docs/THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" TargetPath="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
  <Target Name="CollectDistributionNotices" AfterTargets="ComputeFilesToPublish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_GfCorePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_GfDesktopPack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
      <_GfNotice Include="@(_GfCorePack->'%(PackageDirectory)/LICENSE.TXT')" RelativePath="Licencas/DotNET/LICENSE.txt" />
      <_GfNotice Include="@(_GfCorePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" RelativePath="Licencas/DotNET/THIRD-PARTY-NOTICES.txt" />
      <_GfNotice Include="@(_GfDesktopPack->'%(PackageDirectory)/LICENSE')" RelativePath="Licencas/WindowsDesktop/LICENSE.txt" />
      <_GfNotice Include="$(PkgMicrosoft_WindowsPackageManager_ComInterop)/NOTICE.txt" RelativePath="Licencas/WinGet/NOTICE.txt" />
      <ResolvedFileToPublish Include="@(_GfNotice)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(_GfCorePack)' == '' Or '@(_GfDesktopPack)' == ''" Text="Packs de runtime ausentes; nao publicar sem avisos de terceiros." />
    <Error Condition="!Exists('%(_GfNotice.Identity)')" Text="Aviso de terceiro ausente: %(_GfNotice.RelativePath)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" GeneratePathProperty="true" />
  </ItemGroup>
  <Import Project="BetaTelemetryPolicy.props" />
  <Target Name="ValidateGfBetaEndpoint" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_MatchedGfBetaEndpoint Include="@(GfApprovedBetaEndpoint)" Condition="'%(Identity)' == '$(GfBetaEndpoint)'" />
    </ItemGroup>
    <Error Condition="'$(GfBetaEndpoint)' != '' And ('@(_MatchedGfBetaEndpoint)' == '' Or '$(GfReviewedPrivacyNoticeSha256)' == '')"
      Text="GF_BETA_ENDPOINT_NOT_APPROVED: receptor e aviso exigem revisao em codigo." />
    <Error Condition="'$(GfBetaEndpoint)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(GfSourceCommit)', '^[a-f0-9]{40}$'))"
      Text="GF_BETA_SOURCE_COMMIT_REQUIRED: a compilacao conectada exige commit fonte exato." />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'@(GfApprovedBetaEndpoint)' != ''">
      <_Parameter1>GfApprovedBetaEndpoint</_Parameter1>
      <_Parameter2>%(GfApprovedBetaEndpoint.Identity)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(GfReviewedPrivacyNoticeSha256)' != ''">
      <_Parameter1>GfReviewedPrivacyNoticeSha256</_Parameter1>
      <_Parameter2>$(GfReviewedPrivacyNoticeSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GfBuildChannel</_Parameter1>
      <_Parameter2>BETA</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GfPrivacyNoticeVersion</_Parameter1>
      <_Parameter2>gf-beta-20261026-r3</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(GfSourceCommit)' != ''">
      <_Parameter1>GfSourceCommit</_Parameter1>
      <_Parameter2>$(GfSourceCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Somente URL do endpoint: nunca token privado no aplicativo. -->
  <ItemGroup Condition="'$(GfBetaEndpoint)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GfBetaEndpoint</_Parameter1>
      <_Parameter2>$(GfBetaEndpoint)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>


