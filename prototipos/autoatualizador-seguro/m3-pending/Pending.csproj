<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GF.Updater.M3.PendingTests</AssemblyName>
    <StartupObject>GfUpdaterFixture.PendingTests</StartupObject>
    <IsPackable>false</IsPackable><IsPublishable>false</IsPublishable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>../packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/*.cs.txt" />
    <Compile Include="PendingInspection.cs.txt" />
    <Compile Include="PendingTests.cs.txt" />
    <PackageReference Include="Tuf" Version="[1.1.1]" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
  </ItemGroup>
</Project>
