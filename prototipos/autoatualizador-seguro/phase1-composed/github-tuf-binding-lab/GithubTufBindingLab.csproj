<Project Sdk="Microsoft.NET.Sdk">
  <!-- CI-only compilation of the exact private GitHub parser/downloader source.
       This project NEVER compiles GfE2eLab, the GF application, or L18. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GfGithubTufBindingLab</AssemblyName>
    <Version>5.13.11.65</Version>
    <AssemblyVersion>5.13.11.65</AssemblyVersion>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../GfGithubWeeklyUpdate.cs.txt" />
    <Compile Include="GithubTufBindingLab.cs.txt" />
  </ItemGroup>
</Project>
