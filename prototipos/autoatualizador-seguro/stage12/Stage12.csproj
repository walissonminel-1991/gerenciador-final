<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>GF.Updater.Stage12.Tests</AssemblyName><StartupObject>GfUpdaterFixture.Tests12</StartupObject>
    <IsPackable>false</IsPackable><IsPublishable>false</IsPublishable><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs.txt;../stage11/src/*.cs.txt" />
    <Compile Include="../src/StrictMetadata.cs.txt;../src/ZipInspection.cs.txt;../src/PersistentState.cs.txt;../src/TransactionPrototype.cs.txt;../src/WindowsFileGuard.cs.txt;../src/CycleClock.cs.txt" />
    <Compile Include="../stage8/src/OwnedAttempt.cs.txt;../stage8/src/TufAttempt.cs.txt" />
    <Compile Include="../stage9/src/FixtureHarness.cs.txt;../stage9/src/OperationJournal.cs.txt;../stage9/src/IntegratedPipeline.cs.txt" />
    <Compile Include="$(Stage8Source)/src/Tuf/**/*.cs" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
  </ItemGroup>
  <Target Name="RequirePinnedFixtureSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Stage8Source)' == ''" Text="Use stage12/run_tests.py; generated sources/outputs must remain external." />
  </Target>
</Project>
