<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GF.Updater.Stage3.Tests</AssemblyName><StartupObject>GfUpdaterFixture.Stage3Tests</StartupObject>
    <IsPackable>false</IsPackable><IsPublishable>false</IsPublishable><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>stage3.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/*.cs.txt" /><Compile Include="src/*.cs.txt" />
    <PackageReference Include="Tuf" Version="[1.1.1]" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
    <ProjectReference Include="$(ClockExperimentProject)" Aliases="Clocked" />
  </ItemGroup>
  <Target Name="RequireIsolatedClockExperiment" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ClockExperimentProject)' == ''" Text="Run stage3/run_tests.py; pinned clock experiment is required." />
  </Target>
</Project>
