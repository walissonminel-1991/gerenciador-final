<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultItems>false</EnableDefaultItems><AssemblyName>GF.Updater.Stage8.Tests</AssemblyName>
    <IsPackable>false</IsPackable><IsPublishable>false</IsPublishable><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs.txt" /><Compile Include="../src/StrictMetadata.cs.txt" /><Compile Include="../src/ZipInspection.cs.txt" />
    <Compile Include="$(Stage8Source)/src/Tuf/**/*.cs" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
  </ItemGroup>
  <Target Name="RequireStage8Source" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Stage8Source)' == ''" Text="Run stage8/run_tests.py; pinned source must remain outside repository." />
  </Target>
</Project>
