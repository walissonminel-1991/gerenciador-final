# EXEMPLO APENAS, NAO IMPLANTAR SEM AUDITORIA E SERVICO PRIVADO.
name = "gerenciador-final-beta-private"
main = "worker.mjs"
compatibility_date = "2026-10-26"
# Desabilitar o dominio sem WAF e URLs de preview; habilitar SOMENTE
# um Custom Domain/route auditado da zona Cloudflare com WAF.
workers_dev = false
preview_urls = false
[vars]
PILOT_ENABLED = "no"
GITHUB_EXPORT_ENABLED = "no"
GITHUB_PRIVATE_REPO = "PREENCHER/REPOSITORIO-PRIVADO"
[triggers]
crons = ["0 4 * * *"]
[[d1_databases]]
binding = "DB"
database_name = "gf-beta-private"
database_id = "PREENCHER_ID_D1"
# Substituir 1001 por um namespace_id positivo e exclusivo da conta.
# API de rate limiting aproximada por PoP: NAO substitui uma regra WAF.
[[ratelimits]]
name = "BETA_RATE_LIMITER"
namespace_id = "1001"
[ratelimits.simple]
limit = 6
period = 60

# Antes de ativar: configurar WAF/rate limit na zona/domínio personalizado,
# revisar logging/redacao do IP, e validar deploy/D1 de forma controlada.
# GITHUB_TOKEN deve ser SECRET somente do Worker (issues:write E metadata:read),
# restrito a um unico repositorio PRIVADO; jamais fazer commit desse segredo.
# PILOT_ENABLED permanece "no" ate todos os gates de aprovacao.
